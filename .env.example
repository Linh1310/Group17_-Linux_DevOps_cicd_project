# Copy thành .env rồi điền giá trị thật:  cp .env.example .env && chmod 600 .env
# KHÔNG commit file .env lên Git (chứa token bí mật)

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ---------- Ứng dụng ----------
IMAGE=ghcr.io/ten-nhom/ten-app
IMAGE_TAG=latest
CONTAINER_NAME=myapp
APP_PORT=8000
CONTAINER_PORT=8000
HEALTH_URL=http://127.0.0.1:8000/

# File biến môi trường riêng cho app (tùy chọn, bỏ trống nếu không dùng)
APP_ENV_FILE=

# ---------- Health check (tùy chọn) ----------
HEALTH_RETRIES=15
HEALTH_INTERVAL=2

# ---------- Giám sát của bot (tùy chọn) ----------
MONITOR_INTERVAL=60
FAIL_THRESHOLD=2
